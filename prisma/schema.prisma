generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserStats {
  id        String   @id @default(uuid())
  ip        String
  country   String
  city      String
  userAgent String
  createdAt DateTime @default(now())
}

model AdminLoginHistory {
  id        String   @id @default(uuid())
  ip        String
  country   String
  city      String
  userAgent String
  createdAt DateTime @default(now())
  username  String
  success   Boolean
}

model Guest {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rsvp      Rsvp?
}

enum RsvpStatus {
  yes
  no
}

model Rsvp {
  id        String     @id @default(uuid())
  guestId   String     @unique
  guest     Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  status    RsvpStatus
  /// Phone or email, when attending.
  contact   String?
  /// Reason, when not attending.
  reason    String?
  wish      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
