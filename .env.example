# Resend API key used by app/api/contact/route.ts to send the contact form email.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Destination inbox that receives contact form submissions.
CONTACT_TO_EMAIL=

DATABASE_URL=

# Sender address for Resend emails (contact form + graduation RSVP).
CONTACT_FROM_EMAIL=

# Admin login + HMAC secret for the admin session cookie (any long random string).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Phone shown under the graduation RSVP "attending" form (optional; hidden when empty).
GRADUATION_OWNER_PHONE=
